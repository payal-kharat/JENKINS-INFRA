pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select the Terraform environment'
        )

        booleanParam(
            name: 'APPLY',
            defaultValue: false,
            description: 'Apply Terraform changes after plan'
        )

        booleanParam(
            name: 'DESTROY',
            defaultValue: false,
            description: 'Destroy all Terraform resources for the selected environment'
        )
    }

    environment {
        AWS_REGION = 'us-east-1'
        TF_IN_AUTOMATION = 'true'
        AWS_CRED = 'AWS'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
    steps {
        dir('INFRA') {
            withCredentials([
                [$class: 'AmazonWebServicesCredentialsBinding',
                 credentialsId: 'AWS']
            ]) {
                sh '''
                    set -e

                    export AWS_DEFAULT_REGION="$AWS_REGION"

                    if [ -z "$ENVIRONMENT" ]; then
                        echo "ERROR: ENVIRONMENT is empty"
                        exit 1
                    fi

                    STATE_KEY="employee-mgm/${ENVIRONMENT}/terraform.tfstate"

                    echo "=========================================="
                    echo "Terraform Environment : ${ENVIRONMENT}"
                    echo "Terraform State       : ${STATE_KEY}"
                    echo "=========================================="

                    rm -rf .terraform

                    terraform init \
                        -input=false \
                        -reconfigure \
                        -backend-config="key=${STATE_KEY}"

                    echo "=========================================="
                    echo "Terraform backend:"
                    terraform state pull | head -c 500
                    echo
                    echo "=========================================="
                '''
            }
        }
    }
}

        // stage('Terraform Validate') {
        //     steps {
        //         dir('INFRA') {
        //             sh '''
        //                 terraform fmt -check -recursive
        //                 terraform validate
        //             '''
        //         }
        //     }
        // }

        stage('Terraform Plan') {
            when {
                expression {
                    return !params.DESTROY
                }
            }

            steps {
                dir('INFRA') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'AWS']
                    ]) {
                        sh '''
                            set -e

                            export AWS_DEFAULT_REGION="$AWS_REGION"

                            terraform plan \
                                -input=false \
                                -var-file="env/${ENVIRONMENT}.tfvars" \
                                -out="tfplan-${ENVIRONMENT}"
                        '''
                    }
                }
            }
        }

        stage('Terraform Apply') {
            when {
                expression {
                    return params.APPLY && !params.DESTROY
                }
            }

            steps {
                dir('INFRA') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'AWS']
                    ]) {
                        sh '''
                            set -e

                            export AWS_DEFAULT_REGION="$AWS_REGION"

                            terraform apply \
                                -input=false \
                                -auto-approve \
                                "tfplan-${ENVIRONMENT}"
                        '''
                    }
                }
            }
        }

        stage('Terraform Destroy') {
            when {
                expression {
                    return params.DESTROY
                }
            }

            steps {
                dir('INFRA') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'AWS']
                    ]) {
                        sh '''
                            set -e

                            export AWS_DEFAULT_REGION="$AWS_REGION"

                            echo "=========================================="
                            echo "WARNING: Terraform DESTROY"
                            echo "Environment: ${ENVIRONMENT}"
                            echo "=========================================="

                            terraform plan \
                                -destroy \
                                -input=false \
                                -var-file="env/${ENVIRONMENT}.tfvars" \
                                -out="destroy-${ENVIRONMENT}"

                            terraform apply \
                                -input=false \
                                -auto-approve \
                                "destroy-${ENVIRONMENT}"
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Terraform pipeline completed successfully for ${params.ENVIRONMENT}"
        }

        failure {
            echo "Terraform pipeline failed for ${params.ENVIRONMENT}"
        }

        always {
            echo "Terraform environment: ${params.ENVIRONMENT}"
        }
    }
}
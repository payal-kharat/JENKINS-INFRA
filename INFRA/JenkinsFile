
pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select the Terraform environment'
        )

        booleanParam(
            name: 'APPLY',
            defaultValue: false,
            description: 'Apply Terraform changes after plan'
        )

        booleanParam(
            name: 'DESTROY',
            defaultValue: false,
            description: 'Destroy all Terraform resources for the selected environment'
        )
    }

    environment {
        AWS_REGION = 'us-east-1'
        TF_IN_AUTOMATION = 'true'
        AWS_CRED = 'AWS'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate Parameters') {
            steps {
                script {
                    if (params.APPLY && params.DESTROY) {
                        error('APPLY and DESTROY cannot both be true. Select only one action.')
                    }
                }
            }
        }

        stage('Terraform Init') {
            steps {
                dir('INFRA') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'AWS']
                    ]) {
                        sh '''
                            set -e

                            export AWS_DEFAULT_REGION="$AWS_REGION"

                            if [ -z "$ENVIRONMENT" ]; then
                                echo "ERROR: ENVIRONMENT is empty"
                                exit 1
                            fi

                            BACKEND_CONFIG="backend_conf/backend_${ENVIRONMENT}.conf"

                            if [ ! -f "$BACKEND_CONFIG" ]; then
                                echo "ERROR: Backend configuration not found: $BACKEND_CONFIG"
                                exit 1
                            fi

                            if [ ! -f "env/${ENVIRONMENT}.tfvars" ]; then
                                echo "ERROR: Terraform variable file not found: env/${ENVIRONMENT}.tfvars"
                                exit 1
                            fi

                            echo "=========================================="
                            echo "Terraform Environment : ${ENVIRONMENT}"
                            echo "Terraform Backend     : ${BACKEND_CONFIG}"
                            echo "Terraform Variables   : env/${ENVIRONMENT}.tfvars"
                            echo "=========================================="

                            rm -rf .terraform

                            terraform init \
                                -input=false \
                                -reconfigure \
                                -backend-config="$BACKEND_CONFIG"

                            echo "=========================================="
                            echo "Terraform backend initialized successfully"
                            echo "=========================================="
                        '''
                    }
                }
            }
        }

        stage('Terraform Plan') {
            when {
                expression {
                    return !params.DESTROY
                }
            }

            steps {
                dir('INFRA') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'AWS']
                    ]) {
                        sh '''
                            set -e

                            export AWS_DEFAULT_REGION="$AWS_REGION"

                            terraform plan \
                                -input=false \
                                -var-file="env/${ENVIRONMENT}.tfvars" \
                                -out="tfplan-${ENVIRONMENT}"
                        '''
                    }
                }
            }
        }

        stage('Manual Approval - Apply') {
            when {
                expression {
                    return params.APPLY && !params.DESTROY && params.ENVIRONMENT != 'dev'
                }
            }

            steps {
                input(
                    message: "Approve Terraform APPLY for ${params.ENVIRONMENT}?",
                    ok: 'Approve Apply'
                )
            }
        }

        stage('Terraform Apply') {
            when {
                expression {
                    return params.APPLY && !params.DESTROY
                }
            }

            steps {
                dir('INFRA') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'AWS']
                    ]) {
                        sh '''
                            set -e

                            export AWS_DEFAULT_REGION="$AWS_REGION"

                            terraform apply \
                                -input=false \
                                -auto-approve \
                                "tfplan-${ENVIRONMENT}"
                        '''
                    }
                }
            }
        }

        stage('Terraform Destroy Plan') {
            when {
                expression {
                    return params.DESTROY
                }
            }

            steps {
                dir('INFRA') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'AWS']
                    ]) {
                        sh '''
                            set -e

                            export AWS_DEFAULT_REGION="$AWS_REGION"

                            echo "=========================================="
                            echo "WARNING: Terraform DESTROY PLAN"
                            echo "Environment: ${ENVIRONMENT}"
                            echo "=========================================="

                            terraform plan \
                                -destroy \
                                -input=false \
                                -var-file="env/${ENVIRONMENT}.tfvars" \
                                -out="destroy-${ENVIRONMENT}"
                        '''
                    }
                }
            }
        }

        stage('Manual Approval - Destroy') {
            when {
                expression {
                    return params.DESTROY
                }
            }

            steps {
                input(
                    message: "WARNING: Approve Terraform DESTROY for ${params.ENVIRONMENT}?",
                    ok: 'Approve Destroy'
                )
            }
        }

        stage('Terraform Destroy') {
            when {
                expression {
                    return params.DESTROY
                }
            }

            steps {
                dir('INFRA') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'AWS']
                    ]) {
                        sh '''
                            set -e

                            export AWS_DEFAULT_REGION="$AWS_REGION"

                            terraform apply \
                                -input=false \
                                -auto-approve \
                                "destroy-${ENVIRONMENT}"
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Terraform pipeline completed successfully for ${params.ENVIRONMENT}"
        }

        failure {
            echo "Terraform pipeline failed for ${params.ENVIRONMENT}"
        }

        always {
            echo "Terraform environment: ${params.ENVIRONMENT}"
        }
    }
}

